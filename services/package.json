{
  "name": "@hushd/services",
  "version": "0.1.0",
  "private": true,
  "description": "Hushd services: relayer, indexer, API, matcher client, reference makers, keeper and top-up.",
  "author": "Arham Khan",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "deploy:mainnet": "HUSHD_NETWORK=mainnet tsx scripts/deploy.ts",
    "verify": "tsx scripts/verify.ts",
    "stack": "tsx scripts/stack.ts",
    "intents:sandbox": "tsx scripts/intents-sandbox.ts",
    "mainnet:sandbox": "tsx scripts/mainnet-sandbox.ts",
    "intents:mainnet": "tsx scripts/intents-mainnet.ts",
    "policy-wallet": "tsx scripts/policy-wallet.ts",
    "agent-api": "tsx scripts/agent-api.ts",
    "hedge:check": "tsx scripts/hedge-check.ts"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hushd/mcp": "workspace:*",
    "@hushd/protocol": "workspace:*",
    "@hushd/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@near-intents-agent-api/sdk": "0.8.0",
    "@nearai/inference-sdk": "0.2.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "hono": "^4.13.16",
    "near-kit": "0.20.2",
    "pg": "^8.23.1",
    "snarkjs": "0.7.5"
  }
}
