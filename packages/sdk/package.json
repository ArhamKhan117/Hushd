{
  "name": "@hushd/sdk",
  "version": "0.1.0",
  "description": "Hushd SDK: private balances, private sends, proofs for one named reader and OTC package trading on NEAR.",
  "author": "Arham Khan",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "circomlibjs": "0.1.7",
    "near-kit": "0.20.2",
    "snarkjs": "0.7.5",
    "ffjavascript": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArhamKhan117/hushd.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://hushd.net",
  "bugs": "https://github.com/ArhamKhan117/hushd/issues",
  "keywords": [
    "near",
    "privacy",
    "zk",
    "otc",
    "wallet"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  }
}
