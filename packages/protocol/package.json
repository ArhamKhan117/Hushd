{
  "name": "@hushd/protocol",
  "version": "0.1.0",
  "description": "Hushd package protocol: typed OTC packages, quotes and receipts, exact integer math and the canonical bytes makers and the matcher enclave sign.",
  "author": "Arham Khan",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArhamKhan117/Hushd.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://hushd.net",
  "bugs": "https://github.com/ArhamKhan117/Hushd/issues",
  "keywords": [
    "near",
    "otc",
    "rfq",
    "protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
