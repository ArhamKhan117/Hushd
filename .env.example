# Hushd environment. Copy to .env (gitignored) and fill in what you run.
# Every value has a public testnet default except keys. Without keys the API runs
# read-only and the app works in read-only mode against the public testnet contracts.

# ---------- network ----------
HUSHD_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
# Contract overrides (defaults: pool.hushd.testnet, desk.hushd.testnet, board.hushd.testnet)
HUSHD_POOL=
HUSHD_DESK=
HUSHD_BOARD=

# ---------- app (Next.js, public) ----------
NEXT_PUBLIC_HUSHD_API_URL=https://api.hushd.net
NEXT_PUBLIC_NEAR_RPC_URL=
NEXT_PUBLIC_HUSHD_POOL=
NEXT_PUBLIC_HUSHD_DESK=
NEXT_PUBLIC_HUSHD_BOARD=

# ---------- services ----------
DATABASE_URL=postgres://localhost:5432/hushd
API_HOST=api.hushd.net
API_PER_MINUTE=240
# Indexer: "transactions" (FastNEAR's free per-contract transactions API) or "blocks" (the
# neardata stream; its free tier is slower than testnet, so set NEARDATA_API_KEY for it)
INDEXER_SOURCE=transactions
INDEXER_POLL_MS=4000
FASTNEAR_TX_URL=https://tx.test.fastnear.com
INDEXER_FROM_BLOCK=0
NEARDATA_URL=https://testnet.neardata.xyz
NEARDATA_API_KEY=

# Relayer: sends proven actions from its own account. A gas key adds parallel nonce lanes.
RELAYER_ACCOUNT=relayer.hushd.testnet
RELAYER_PRIVATE_KEY=ed25519:replace-me
RELAYER_GAS_KEY=
RELAYER_LANES=8
RELAYER_DAILY_GAS=300000000000000000
RELAYER_CASHOUT_FEE_BPS=0
RELAYER_PER_MINUTE=30
RELAYER_ACTIVATE_YOCTO=200000000000000000000000
RELAYER_ACTIVATIONS_PER_DAY=200

# Matcher client: asks the OutLayer enclave to match, then submits its signed result.
MATCHER_ACCOUNT=matcher.hushd.testnet
MATCHER_PRIVATE_KEY=ed25519:replace-me
OUTLAYER_API=https://testnet-api.outlayer.ai
OUTLAYER_PROJECT=hushd.testnet/matcher
OUTLAYER_KEY=replace-me
# Whose OutLayer secrets the matcher loads (the project owner by default)
OUTLAYER_SECRETS_OWNER=hushd.testnet

# Reference makers (three styles). SEED: 32 bytes hex (their private wallet). QUOTE_KEY: ed25519 secret, 32 bytes hex.
# A maker's NEAR account is a policy wallet (POLICY_WALLET_KEY and _ACCOUNT, made with
# `scripts/policy-wallet.ts create MAKER_A`), or an account with its own PRIVATE_KEY.
# HL_KEY: the maker's Hyperliquid testnet account key (0x hex); it approves each hedged deal's address
# as its agent, and the maker quotes hedged packages only while that account has the margin.
MAKERS_PUBLIC_URL=https://api.hushd.net
MAKERS_DATA_DIR=./data/makers
X402_QUOTE_PRICE=10000
MAKER_BOND=20000000000
CUSTODY_URL=https://testnet-api.outlayer.ai
MAKER_A_POLICY_WALLET_KEY=
MAKER_A_POLICY_WALLET_ACCOUNT=
MAKER_A_ACCOUNT=
MAKER_A_PRIVATE_KEY=
MAKER_A_SEED=replace-me-64-hex
MAKER_A_QUOTE_KEY=replace-me
MAKER_A_HL_KEY=
MAKER_B_POLICY_WALLET_KEY=
MAKER_B_POLICY_WALLET_ACCOUNT=
MAKER_B_ACCOUNT=
MAKER_B_PRIVATE_KEY=
MAKER_B_SEED=replace-me-64-hex
MAKER_B_QUOTE_KEY=replace-me
MAKER_B_HL_KEY=
MAKER_C_POLICY_WALLET_KEY=
MAKER_C_POLICY_WALLET_ACCOUNT=
MAKER_C_ACCOUNT=
MAKER_C_PRIVATE_KEY=
MAKER_C_SEED=replace-me-64-hex
MAKER_C_QUOTE_KEY=replace-me
MAKER_C_HL_KEY=

# Keeper: has the MPC sign hedge orders, sends them to Hyperliquid testnet, records fills.
KEEPER_ACCOUNT=keeper.hushd.testnet
KEEPER_PRIVATE_KEY=ed25519:replace-me
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_TESTNET_INFO_URL=https://api.hyperliquid-testnet.xyz/info
HYPERLIQUID_TESTNET_EXCHANGE_URL=https://api.hyperliquid-testnet.xyz/exchange
# NEAR Intents 1Click (mainnet). Dry quotes: a second price for the makers, and the API's previews
# of deposits from and cash-outs to other chains. A partner key (partners.near-intents.org, sent as
# X-API-Key) makes those quotes confidential and lowers the fee on real swaps.
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=

# Top-up: keeps service accounts funded from the treasury (floors in NEAR). Add each maker's
# policy wallet account too, e.g. <64-hex account>:0.3, once the wallets exist.
TREASURY_ACCOUNT=hushd-treasury.testnet
TREASURY_PRIVATE_KEY=ed25519:replace-me
TREASURY_LOW_YOCTO=5000000000000000000000000
TOPUP_TARGETS=relayer.hushd.testnet:5,matcher.hushd.testnet:2,keeper.hushd.testnet:2
TOPUP_EVERY_MS=300000
SERVICE_ACCOUNTS=relayer.hushd.testnet,matcher.hushd.testnet,keeper.hushd.testnet

# NEAR AI Cloud: plain-language intake (verifiable models only). Without a key the
# attestation is still shown and the intake is off.
NEARAI_API_KEY=
NEARAI_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=z-ai/glm-5.3-flash

# NEAR's Agent Market worker ("Hushd price check"): idle until the listing is registered
# (scripts/market-listing.ts --register writes MARKET_AGENT_TOKEN and MARKET_AGENT_ID).
# MARKET_AGENT_SEED: 64 hex, its own Hushd balance for paying the makers' x402 quotes.
MARKET_URL=https://market.near.ai
MARKET_AGENT_TOKEN=
MARKET_AGENT_ID=
MARKET_AGENT_SEED=
MARKET_POLL_MS=10000

# Mainnet NEAR Intents demo (scripts/intents-mainnet.ts): three implicit accounts' secrets
# (64 hex each, made on the first run). Nothing is sent without --execute.
INTENTS_DEV_SECRET=
INTENTS_TRADER_SECRET=
INTENTS_MAKER_SECRET=

# The demo agent (scripts/demo-agent.ts)
DEMO_AGENT_SEED=
DEMO_AGENT_POLICY_WALLET_KEY=
DEMO_AGENT_POLICY_WALLET_ACCOUNT=

# ---------- MCP server (an agent's own machine) ----------
HUSHD_SEED=
HUSHD_HOME=
HUSHD_API_URL=https://api.hushd.net
HUSHD_CIRCUITS_URL=https://hushd.net/circuits
# The agent's NEAR account: a policy wallet's key (wk_..., checked in OutLayer's TEE), or an account and its key
HUSHD_POLICY_WALLET_KEY=
HUSHD_CUSTODY_URL=https://testnet-api.outlayer.ai
HUSHD_NEAR_ACCOUNT=
HUSHD_NEAR_PRIVATE_KEY=
HUSHD_LIMIT_PER_PAYMENT=USDC=100,wNEAR=50,BTC=0.002
HUSHD_LIMIT_PER_DAY=USDC=500,wNEAR=250,BTC=0.01
# The owner's other rules: no spending after this date, and only these payees (hushd1... or NEAR accounts)
HUSHD_LIMITS_EXPIRE=
HUSHD_ALLOW_TO=
